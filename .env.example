# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase: Project Settings → API (or Connect) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Sign-in providers on /login (email magic link is always on).
# Google is shown unless this is "false".
NEXT_PUBLIC_AUTH_GOOGLE=true
# LinkedIn is hidden until this is "true" (also enable "LinkedIn (OIDC)" in Supabase).
NEXT_PUBLIC_AUTH_LINKEDIN=false

# Show draft courses (development only).
SHOW_DRAFTS=false
