# Every setting the site reads. Copy this file to .env.local for your own computer
# (never commit .env.local), and add the same names in Vercel → Project → Settings →
# Environment Variables for the live site. All of them are optional: without any,
# the site works with no accounts and progress saved in the browser.

# The site's public address, used for full links (e.g. in the news RSS feed).
# On Vercel you can leave it out until you have your own domain: Vercel's own
# address is used automatically. Locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (accounts and synced progress): Project Settings → API in the Supabase
# dashboard. Leave both out to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side Supabase key (Project Settings → API Keys → "Secret keys", starts with
# sb_secret_; or the older service_role key). Server only: never give it a NEXT_PUBLIC_
# name and never share it. Used by the daily keep-alive below; optional (without it
# the keep-alive uses the public key, which still counts as activity).
SUPABASE_SECRET_KEY=

# Protects /api/keep-alive, which Vercel Cron calls once a day (vercel.json) so the
# Supabase project isn't paused for inactivity. Any long random string, e.g. from
# `openssl rand -hex 32`. In Vercel, add it under the exact name CRON_SECRET: Vercel
# then sends it with each cron call automatically.
CRON_SECRET=

# Sign-in options on /login (email magic link is always on when Supabase is set up).
# Google is shown unless this is "false".
NEXT_PUBLIC_AUTH_GOOGLE=true
# LinkedIn is hidden until this is "true" (also enable "LinkedIn (OIDC)" in Supabase).
NEXT_PUBLIC_AUTH_LINKEDIN=false

# DRAFT MODE. When "true": draft courses (status "draft" in course.json) are shown,
# with a Draft/Published filter on /learn. Use "true" only on your own computer;
# leave it out (or "false") on Vercel so visitors never see drafts.
# (The Radar's "Make this a post" button is for the signed-in owner, not this flag.)
SHOW_DRAFTS=false
