# Every setting the site reads. Copy this file to .env.local for your own computer
# (never commit .env.local), and add the same names in Vercel → Project → Settings →
# Environment Variables for the live site. All of them are optional: without any,
# the site works with no accounts and progress saved in the browser.

# The site's public address, used for full links (e.g. in the news RSS feed).
# On Vercel you can leave it out until you have your own domain: Vercel's own
# address is used automatically. Locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (accounts and synced progress): Project Settings → API in the Supabase
# dashboard. Leave both out to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Sign-in options on /login (email magic link is always on when Supabase is set up).
# Google is shown unless this is "false".
NEXT_PUBLIC_AUTH_GOOGLE=true
# LinkedIn is hidden until this is "true" (also enable "LinkedIn (OIDC)" in Supabase).
NEXT_PUBLIC_AUTH_LINKEDIN=false

# DRAFT MODE. When "true": draft courses (status "draft" in course.json) are shown,
# with a Draft/Published filter on /learn, and every Radar headline on /news gets a
# "Make this a post" button. Use "true" only on your own computer; leave it out
# (or "false") on Vercel so visitors never see drafts.
SHOW_DRAFTS=false
